              1
            </div>
            <p class="ml-4 text-blue-100">Create an account and set up your organization profile</p>
          </li>
          <li class="flex items-start">
            <div class="bg-white rounded-full w-8 h-8 flex items-center justify-center text-blue-700 font-bold flex-shrink-0">
              2
            </div>
            <p class="ml-4 text-blue-100">Start a new assessment and select the ASVS version and level</p>
          </li>
          <li class="flex items-start">
            <div class="bg-white rounded-full w-8 h-8 flex items-center justify-center text-blue-700 font-bold flex-shrink-0">
              3
            </div>
            <p class="ml-4 text-blue-100">Begin verifying requirements and tracking your progress</p>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

