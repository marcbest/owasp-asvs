<!-- Getting Started Section -->
<div class="max-w-6xl mx-auto py-16 px-6">
  <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-xl shadow-lg overflow-hidden">
    <div class="md:flex">
      <div class="md:w-1/2 p-10 text-white">
        <h2 class="text-3xl font-bold">Ready to Get Started?</h2>
        <p class="mt-4 text-blue-100 text-lg">
          Join hundreds of security professionals and developers who are already using our tool to improve their application security.
        </p>
                  <div class="mt-8">
            <%= link_to new_user_registration_path, class: "inline-block bg-white text-blue-700 px-6 py-3 rounded-lg font-medium hover:bg-blue-50 transition" do %>
