<!-- Hero Section -->
<div class="relative w-full bg-gradient-to-br from-blue-600 to-indigo-800 text-white py-24 px-6 shadow-lg">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row items-center">
      <div class="md:w-3/5">
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">Simplify Your Application Security Verification</h1>
        <p class="mt-6 text-xl text-blue-100">
          A powerful, intuitive platform for conducting <strong>OWASP Application Security Verification Standard (ASVS)</strong> assessments that helps you build more secure applications.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center bg-white text-blue-700 px-6 py-3 rounded-lg text-lg font-medium hover:bg-blue-50 transition shadow-md" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Create Free Account
          <% end %>
          
          <a href="https://owasp.org/www-project-application-security-verification-standard/"
             target="_blank"
             class="inline-flex items-center justify-center border-2 border-white text-white px-6 py-3 rounded-lg text-lg font-medium hover:bg-white hover:text-blue-700 transition">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Learn About ASVS
          </a>
        </div>
      </div>
      <div class="md:w-2/5 mt-10 md:mt-0 flex justify-center">
        <div class="relative w-64 h-64 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center">
          <svg class="w-40 h-40 text-white" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- What is ASVS Section -->
<div class="max-w-6xl mx-auto py-16 px-6">
  <div class="text-center">
    <h2 class="text-3xl font-bold text-gray-900">What is OWASP ASVS?</h2>
    <div class="w-16 h-1 mx-auto bg-blue-600 my-4"></div>
    <p class="max-w-3xl mx-auto text-lg text-gray-600">
      The <strong>OWASP Application Security Verification Standard (ASVS)</strong> is a framework of security requirements and controls that defines increasing levels of application security verification. It helps organizations build and maintain secure applications and can be used to establish a level of confidence in the security of web applications.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition flex flex-col items-center text-center">
      <div class="bg-blue-100 p-3 rounded-full mb-4">
        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-gray-900">Security Requirements</h3>
      <p class="mt-3 text-gray-600">
        Provides a comprehensive set of requirements for building secure applications across different security domains.
      </p>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition flex flex-col items-center text-center">
      <div class="bg-green-100 p-3 rounded-full mb-4">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-gray-900">Multiple Security Levels</h3>
      <p class="mt-3 text-gray-600">
        Defines three security verification levels (1-3) to match different application risk profiles and security needs.
      </p>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition flex flex-col items-center text-center">
      <div class="bg-purple-100 p-3 rounded-full mb-4">
        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-gray-900">Industry Standard</h3>
      <p class="mt-3 text-gray-600">
        Widely adopted by organizations around the world as a benchmark for application security verification.
      </p>
    </div>
  </div>
</div>

<!-- About This Tool Section -->
