<!-- Navbar -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md shadow-sm py-4">
  <div class="container-wide flex items-center justify-between">
    <a href="<%= root_path %>" class="flex items-center gap-2">
      <svg class="h-6 w-6 text-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span class="font-semibold text-xl">ASVS Portal</span>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center gap-8">
      <% if user_signed_in? %>
        <!-- Only show user info when logged in -->
        <div class="flex items-center gap-4">
          <div class="text-sm text-gray-600">
            Hello, <%= current_user.email %>
          </div>
          <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-gray-100 text-gray-800 hover:bg-gray-200 h-10 px-4 py-2" %>
        </div>
      <% else %>
        <!-- Show navigation links and login buttons for logged out users -->
        <ul class="flex items-center gap-6">
          <li>
            <a href="#features" class="text-gray-700 hover:text-primary transition-colors">
              Features
            </a>
          </li>
          <li>
            <a href="#about" class="text-gray-700 hover:text-primary transition-colors">
              About ASVS
            </a>
          </li>
          <li>
            <a href="#get-started" class="text-gray-700 hover:text-primary transition-colors">
              Documentation
            </a>
          </li>
        </ul>

        <div class="flex items-center gap-2">
          <%= link_to "Login", new_user_session_path, class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-white border border-gray-200 text-gray-800 hover:bg-gray-50 h-10 px-4 py-2" %>
          <a href="#get-started" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-white hover:bg-primary/90 h-10 px-4 py-2">
            Get Started
          </a>
        </div>
      <% end %>
    </div>

    <!-- Mobile Menu Button -->
    <button class="md:hidden text-gray-700 p-2" aria-label="Toggle mobile menu">
      <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile Menu Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.querySelector('button[aria-label="Toggle mobile menu"]');
    if (menuButton) {
      menuButton.addEventListener('click', () => {
        const mobileMenu = document.createElement('div');
        mobileMenu.className = 'fixed inset-x-0 top-[72px] bg-white/90 backdrop-blur-lg md:hidden shadow-lg z-50';
        
        // Check if user is logged in
        const isLoggedIn = <%= user_signed_in? %>;
        const userEmail = '<%= user_signed_in? ? current_user.email : "" %>';
        
        let menuContent = '';
        
        if (isLoggedIn) {
          // Only show user info for logged in users
          menuContent = `
            <div class="container py-6 flex flex-col space-y-4">
              <div class="px-4 py-2 text-gray-600 font-medium">Hello, ${userEmail}</div>
              <form action="<%= destroy_user_session_path %>" method="post" class="px-4 pt-2">
                <input type="hidden" name="_method" value="delete" />
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
                <button type="submit" class="w-full inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-gray-100 text-gray-800 hover:bg-gray-200 h-10 px-4 py-2">
                  Logout
                </button>
              </form>
            </div>
          `;
        } else {
          // Show navigation and login for logged out users
          menuContent = `
            <div class="container py-6 flex flex-col space-y-4">
              <a href="#features" class="px-4 py-2 text-gray-700 hover:text-primary">Features</a>
              <a href="#about" class="px-4 py-2 text-gray-700 hover:text-primary">About ASVS</a>
              <a href="#get-started" class="px-4 py-2 text-gray-700 hover:text-primary">Documentation</a>
              <div class="pt-2 px-4 flex flex-col space-y-2">
                <a href="<%= new_user_session_path %>" class="inline-flex w-full items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-white border border-gray-200 text-gray-800 hover:bg-gray-50 h-10 px-4 py-2">
                  Login
                </a>
                <a href="#get-started" class="inline-flex w-full items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-white hover:bg-primary/90 h-10 px-4 py-2">
                  Get Started
                </a>
              </div>
            </div>
          `;
        }
        
        mobileMenu.innerHTML = menuContent;
        
        const existingMenu = document.querySelector('.fixed.inset-x-0.top-\\[72px\\]');
        if (existingMenu) {
          existingMenu.remove();
        } else {
          document.body.appendChild(mobileMenu);
          
          // Add event listeners to close menu when clicking a link
          mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
              mobileMenu.remove();
            });
          });
        }
      });
    }
  });

  // Add navigation scroll effect
  window.addEventListener('scroll', () => {
    const navbar = document.querySelector('nav');
    if (window.scrollY > 10) {
      navbar.classList.add('bg-white/80', 'backdrop-blur-md', 'shadow-sm');
      navbar.classList.remove('bg-transparent');
    } else {
      navbar.classList.remove('bg-white/80', 'backdrop-blur-md', 'shadow-sm');
      navbar.classList.add('bg-transparent');
    }
  });
  
  // Add scroll behavior to navigation links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('href');
      if (targetId === '#') return;
      
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        window.scrollTo({
          top: targetElement.offsetTop - 80,
          behavior: 'smooth'
        });
      }
    });
  });
</script>