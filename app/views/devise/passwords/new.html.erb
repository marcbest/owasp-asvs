<div class="min-h-[calc(100vh-16rem)] flex items-center justify-center pt-20 pb-12 px-4">
  <div class="max-w-md w-full mx-auto p-8 bg-white rounded-lg shadow-md">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Forgot your password?</h2>
    
    <%= form_with(model: resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, class: "space-y-6") do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", 
                        class: "block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      
      <div class="pt-2">
        <%= f.submit "Send me reset instructions", 
                   class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-md transition duration-150 ease-in-out" %>
      </div>
    <% end %>
    
    <div class="mt-6 text-center text-sm text-gray-600 space-y-2">
      <div>
        <%= link_to "Back to sign in", new_session_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-800" %>
      </div>
      <div>
        Don't have an account? 
        <%= link_to "Sign up", new_registration_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-800" %>
      </div>
    </div>
  </div>
</div>