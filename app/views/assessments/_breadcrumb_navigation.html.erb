<!-- Breadcrumb Navigation -->
<div class="hidden md:flex items-center space-x-1 text-sm mb-3" 
     data-controller="breadcrumb"
     data-breadcrumb-current-section-value="">
  
  <!-- Home -->
  <a href="<%= assessments_path %>" 
     class="flex items-center px-2 py-1 rounded-md text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200 group">
    <svg class="w-4 h-4 mr-1 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20">
      <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
    </svg>
    <span class="font-medium">Home</span>
  </a>
  
  <!-- Separator -->
  <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
  </svg>
  
  <!-- Assessment -->
  <button class="flex items-center px-2 py-1 rounded-md text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200 group max-w-xs" 
          data-action="click->breadcrumb#scrollToTop"
          title="<%= @assessment.name %>">
    <svg class="w-4 h-4 mr-1 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
    </svg>
    <span class="font-medium truncate">
      <%= truncate(@assessment.name, length: 25) %>
    </span>
  </button>
  
  <!-- Current Section (Dynamic) -->
  <template data-breadcrumb-target="sectionTemplate">
    <!-- Separator -->
    <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
    </svg>
    
    <!-- Section Badge -->
    <div class="flex items-center px-2 py-1 bg-blue-100 text-blue-800 rounded-md">
      <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
      </svg>
      <span class="font-medium text-sm" data-breadcrumb-target="sectionName"></span>
    </div>
  </template>
  
  <!-- Dynamic section will be inserted here -->
  <span data-breadcrumb-target="dynamicSection"></span>
</div>