<h1 class="text-2xl font-bold mb-6">Create New Assessment</h1>

<%= form_with model: @assessment, local: true do |f| %>
  <div class="mb-4">
    <%= f.label :asvs_version_id, "Select ASVS Version", class: "block text-gray-700" %>
    <%= f.collection_select :asvs_version_id, @asvs_versions, :id, :version, prompt: "Choose a version", class: "mt-1 block w-full border-gray-300 rounded" %>
  </div>
  <div>
    <%= f.submit "Create Assessment", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
<% end %>
