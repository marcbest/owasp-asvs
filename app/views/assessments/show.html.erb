<%
  # Ensure target_level is always valid (1, 2, or 3)
  target_level = params[:target_level].to_i
  target_level = 1 unless [1, 2, 3].include?(target_level)

  # Get all applicable requirements at the selected level
  applicable_requirements = @assessment.responses
                                       .joins(:requirement)
                                       .where("requirements.l#{target_level}_required = ?", true)
                                       .where(applicable: true)

  total_requirements = applicable_requirements.count
  passed_requirements = applicable_requirements.where(met_requirement: true).count
  progress_percentage = total_requirements > 0 ? ((passed_requirements.to_f / total_requirements) * 100).round(2) : 0
%>

<div class="max-w-screen-2xl mx-auto bg-white shadow rounded-lg p-6">
  <!-- Sticky Progress Bar -->
  <div class="sticky top-0 left-0 w-full bg-white shadow-md z-10 p-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">
          <%= @assessment.asvs_version.name %> – Level <%= target_level %>
        </h1>
        <p class="text-sm text-gray-500">
          Checklist: <%= progress_percentage %>% all pass, total: <%= total_requirements %>
        </p>
      </div>
      <div class="space-x-2">
        <label for="target_level" class="text-sm font-medium text-gray-700">Target Level:</label>
        <select id="target_level" name="target_level"
                class="border-gray-300 rounded px-2 py-1 text-sm"
                onchange="window.location.href = '?target_level=' + this.value">
          <option value="1" <%= "selected" if target_level == 1 %>>Level 1</option>
          <option value="2" <%= "selected" if target_level == 2 %>>Level 2</option>
          <option value="3" <%= "selected" if target_level == 3 %>>Level 3</option>
        </select>
      </div>
    </div>

    <!-- Floating Progress Bar -->
    <div class="w-full bg-gray-200 h-2 rounded mt-2">
      <div class="bg-blue-500 h-2 rounded transition-all duration-300"
           style="width: <%= progress_percentage %>%"></div>
    </div>
  </div>

  <!-- Requirements Table -->
  <div class="overflow-x-auto mt-4">
    <table class="min-w-full border border-gray-200 text-sm">
      <thead class="bg-gray-50 text-gray-700 uppercase text-xs">
        <tr>
          <th scope="col" class="px-4 py-2 font-medium">ID</th>
          <th scope="col" class="px-4 py-2 font-medium">Description</th>
          <th scope="col" class="px-4 py-2 font-medium text-center">L1</th>
          <th scope="col" class="px-4 py-2 font-medium text-center">L2</th>
          <th scope="col" class="px-4 py-2 font-medium text-center">L3</th>
          <th scope="col" class="px-4 py-2 font-medium text-center">Applicable</th>
          <th scope="col" class="px-4 py-2 font-medium text-center">Pass</th>
          <th scope="col" class="px-4 py-2 font-medium">Notes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% top_requirements = @assessment.asvs_version.requirements.where(parent_id: nil) %>
        <% top_requirements.each do |req| %>
          <%= render partial: "assessments/requirement_tree",
                     locals: { req: req, assessment: @assessment, level: 0 } %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
