<div class="container mx-auto p-4">
  <h1 class="font-bold text-4xl mb-6">Assessments</h1>

  <% if @assessments.any? %>
    <table class="min-w-full border-collapse">
      <thead class="bg-gray-200">
        <tr>
          <th class="px-4 py-2 text-left">ID</th>
          <th class="px-4 py-2 text-left">ASVS Version</th>
          <th class="px-4 py-2 text-left">Created At</th>
          <th class="px-4 py-2 text-left">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @assessments.each do |assessment| %>
          <tr class="border-b">
            <td class="px-4 py-2"><%= assessment.id %></td>
            <td class="px-4 py-2"><%= assessment.asvs_version.version %></td>
            <td class="px-4 py-2"><%= assessment.created_at.strftime("%Y-%m-%d") %></td>
            <td class="px-4 py-2">
              <%= link_to "Show", assessment_path(assessment), class: "text-blue-500 hover:underline" %>
              <%= link_to "Edit", assessment_path(assessment), class: "ml-2 text-green-500 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-600">No assessments found.</p>
  <% end %>
</div>
