<!-- app/views/assessments/index.html.erb -->
<div class="max-w-screen-2xl mx-auto p-6" data-controller="modal">
  <!-- Header -->
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">OWASP ASVS Assessments</h1>
    <button data-action="modal#open"
            class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      New Assessment
    </button>
  </div>

  <!-- Assessment Grid -->
  <div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <% @assessments.each do |assessment| %>
      <%= link_to assessment_path(assessment), class: "block bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow duration-200" do %>
        <div class="p-6">
          <div class="flex flex-col">
            <h3 class="text-lg font-semibold text-gray-900 mb-1 truncate"><%= assessment.name %></h3>
            <span class="text-sm text-gray-600 mb-4"><%= assessment.asvs_version.name %> - <%= assessment.asvs_version.version %></span>
            
            <% 
              level_requirements = assessment.responses
                                          .joins(:requirement)
                                          .where("requirements.l1_required = ?", true)
                                          .where(applicable: true)
              total = level_requirements.count
              passed = level_requirements.where(met_requirement: true).count
              progress = total > 0 ? ((passed.to_f / total) * 100).round(2) : 0
            %>
            
            <div class="mt-auto">
              <div class="flex justify-between text-sm text-gray-500 mb-2">
                <span>Level 1 Progress</span>
                <span class="font-medium"><%= progress %>%</span>
              </div>
              <div class="w-full bg-gray-100 rounded-full h-2">
                <div class="bg-blue-600 h-2 rounded-full transition-all duration-300"
                     style="width: <%= progress %>%"></div>
              </div>
              
              <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
                <div class="flex items-center">
                  <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Updated <%= time_ago_in_words(assessment.updated_at) %> ago</span>
                </div>
                <span class="px-2 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-medium">
                  <%= pluralize(total, 'requirement') %>
                </span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- New Assessment Modal -->
  <div data-modal-target="modal" 
       class="hidden fixed inset-0 z-50 overflow-y-auto"
       style="background-color: rgba(75, 85, 99, 0.75);">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-lg relative">
        <h2 class="text-xl font-bold mb-4">New Assessment</h2>
        
        <%= form_with(model: @assessment, local: true, class: "space-y-4") do |f| %>
          <div>
            <label class="block text-sm font-medium text-gray-700">Project Name</label>
            <%= f.text_field :name, 
                            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
                            placeholder: "e.g., Company Website, Mobile App API" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">ASVS Version</label>
            <%= f.collection_select :asvs_version_id, 
                                    @asvs_versions, 
                                    :id, 
                                    ->(v) { "#{v.version} - #{v.name}" }, 
                                    {}, 
                                    class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          </div>

          <div class="mt-6 flex justify-end space-x-3">
            <button type="button" 
                    class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                    data-action="modal#close">
              Cancel
            </button>
            <%= f.submit "Create Assessment", 
                        class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>