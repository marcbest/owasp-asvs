<!-- Modal -->
<div data-modal-target="modal" 
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     style="background-color: rgba(75, 85, 99, 0.75);">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-lg relative">
      <h2 class="text-xl font-bold mb-4">Share Assessment</h2>

    <!-- Sharing Form -->
    <%= form_with(model: [@assessment, SharingUrl.new], local: true, class: "space-y-4") do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700">Description</label>
        <%= f.text_field :description, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Expires at (optional)</label>
        <%= f.datetime_local_field :expires_at, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>
      <%= f.submit "Create Share Link", class: "mt-4 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    <% end %>

    <!-- Sharing Links List -->
    <div class="mt-6">
      <h4 class="text-sm font-medium text-gray-900">Existing Share Links</h4>
      <div class="mt-2 space-y-2">
        <% @assessment.sharing_urls.active.each do |url| %>
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
            <div class="flex-1">
              <p class="text-sm font-medium text-gray-900"><%= url.description %></p>
              <p class="text-xs text-gray-500">
                <%= link_to shared_assessment_url(url.uuid), shared_assessment_path(url.uuid), class: "text-blue-600 hover:text-blue-800" %>
              </p>
              <% if url.expires_at %>
                <p class="text-xs text-gray-500">Expires: <%= url.expires_at.strftime("%Y-%m-%d %H:%M") %></p>
              <% end %>
            </div>
            <%= button_to assessment_sharing_url_path(@assessment, url), 
                          method: :delete, 
                          class: "ml-2 text-red-600 hover:text-red-800",
                          form: { class: "inline-block" } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Close Button -->
    <button type="button" 
            class="mt-4 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-gray-700 hover:bg-gray-50 focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            data-action="click->modal#close">
      Close
    </button>
  </div>
</div>
