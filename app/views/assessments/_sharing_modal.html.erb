<div data-modal-target="modal" 
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     style="background-color: rgba(75, 85, 99, 0.75);">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-lg relative">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-900">Share Assessment</h2>
      </div>

      <div id="sharing_url_form">
        <%= render partial: "sharing_urls/form", locals: { assessment: @assessment } %>
      </div>

      <div class="mt-8 border-t border-gray-200 pt-6">
        <h4 class="text-sm font-medium text-gray-900 mb-3">Existing Share Links</h4>
        <div id="sharing_urls_list">
          <%= render partial: "sharing_urls/list", locals: { urls: @assessment.sharing_urls.active } %>
        </div>
      </div>

      <div class="mt-6 border-t border-gray-200 pt-4">
        <button type="button" 
                class="w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                data-action="click->modal#close">
          Close
        </button>
      </div>
    </div>
  </div>
</div>