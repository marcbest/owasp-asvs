<%
  # Ensure response_obj is initialized correctly
  response_obj = assessment.responses.find_by(requirement_id: req.id) ||
                 assessment.responses.build(requirement: req)
  # Check if the requirement has at least one level
  has_requirements = req.l1_required || req.l2_required || req.l3_required
  # Check if this is a top-level requirement (section header)
  is_section_header = req.parent_id.nil?
  # Set read_only to false by default if not provided
  read_only ||= false
%>
<tr class="hover:bg-gray-50" 
    <% if is_section_header %>id="section-<%= req.shortcode %>"<% end %>>
  <!-- ID / Shortcode -->
  <td class="px-4 py-2" style="padding-left: <%= level * 20 %>px;">
    <span class="font-semibold text-gray-800">
      <%= req.shortcode %>
    </span>
  </td>
  <!-- Requirement Name & Description -->
  <td class="px-4 py-2">
    <div class="text-gray-800 font-medium">
      <% if req.name.present? %>
        <%= raw req.name.gsub(/\[([^\]]+)\]\(([^)]+)\)/, '<a href="\2" target="_blank" class="text-blue-600 hover:underline">\1</a>') %>
      <% end %>
    </div>
    <% if req.description.present? %>
      <div class="text-xs text-gray-500">
        <%= raw req.description.gsub(/\[([^\]]+)\]\(([^)]+)\)/, '<a href="\2" target="_blank" class="text-blue-600 hover:underline">\1</a>') %>
      </div>
    <% end %>
  </td>
  <% if has_requirements %>
    <!-- L1 Required? -->
    <td class="px-4 py-2 text-center"><%= req.l1_required ? "✓" : "—" %></td>
    <!-- L2 Required? -->
    <td class="px-4 py-2 text-center"><%= req.l2_required ? "✓" : "—" %></td>
    <!-- L3 Required? -->
    <td class="px-4 py-2 text-center"><%= req.l3_required ? "✓" : "—" %></td>
    <!-- Applicable Checkbox -->
    <td class="px-4 py-3 text-center">
      <% if read_only %>
        <%= response_obj.applicable? ? "✓" : "—" %>
      <% else %>
        <turbo-frame id="applicable_frame_<%= req.id %>">
          <%= form_with model: [assessment, response_obj],
                        data: { turbo_frame: "applicable_frame_#{req.id}", controller: "auto-save" },
                        local: false do |f| %>
            <%= f.check_box :applicable, data: { action: "change->auto-save#checkboxChanged" },
                                       class: "form-checkbox h-5 w-5 text-blue-600 rounded-md border-2 border-gray-300 focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 transition-all duration-200 cursor-pointer hover:border-blue-400" %>
          <% end %>
        </turbo-frame>
      <% end %>
    </td>
    <!-- Pass / Met requirement -->
    <td class="px-4 py-3 text-center">
      <% if read_only %>
        <%= response_obj.met_requirement? ? "✓" : "—" %>
      <% else %>
        <turbo-frame id="pass_frame_<%= req.id %>">
          <%= form_with model: [assessment, response_obj],
                        data: { turbo_frame: "pass_frame_#{req.id}", controller: "auto-save" },
                        local: false do |f| %>
            <%= f.check_box :met_requirement, data: { action: "change->auto-save#checkboxChanged" },
                                          class: "form-checkbox h-5 w-5 text-green-600 rounded-md border-2 border-gray-300 focus:ring-2 focus:ring-green-500 focus:ring-offset-1 transition-all duration-200 cursor-pointer hover:border-green-400" %>
          <% end %>
        </turbo-frame>
      <% end %>
    </td>
    <!-- Notes / Comments -->
    <td class="px-4 py-3 min-w-[300px]">
      <% if read_only %>
        <div class="text-sm text-gray-700 whitespace-pre-wrap"><%= response_obj.comment %></div>
      <% else %>
        <turbo-frame id="notes_frame_<%= req.id %>" data-controller="expanding-textarea">
          <%= form_with model: [assessment, response_obj],
                        data: { turbo_frame: "notes_frame_#{req.id}", controller: "auto-save" },
                        local: false do |f| %>
            <%= f.text_area :comment,
                           rows: 2,
                           placeholder: "Add notes here...",
                           class: "w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm min-h-[3.5rem] min-w-[250px] transition-all duration-200 ease-in-out hover:border-blue-300 placeholder-gray-400 resize-none shadow-sm",
                           data: { 
                             action: "input->auto-save#commentChanged input->expanding-textarea#resize focus->expanding-textarea#expandOnFocus blur->expanding-textarea#collapseOnBlur", 
                             auto_save_target: "comment",
                             expanding_textarea_target: "textarea",
                             expanding_textarea_max_rows: 10 
                           } %>
          <% end %>
        </turbo-frame>
      <% end %>
    </td>
  <% else %>
    <!-- If this is a section header or a child with no level requirements, fill the space -->
    <td class="px-4 py-2 text-center" colspan="6"></td>
  <% end %>
</tr>
<!-- Always Render Children (Even if they have no requirements) -->
<% if req.children.any? %>
  <% req.children.each do |child| %>
    <%= render partial: "assessments/requirement_tree",
               locals: { req: child, assessment: assessment, level: level + 1, read_only: read_only } %>
  <% end %>
<% end %>