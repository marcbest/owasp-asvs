<div class="space-y-3">
  <% urls.order(created_at: :desc).each do |url| %>
    <%= turbo_frame_tag dom_id(url) do %>
      <div class="flex items-start justify-between p-4 bg-white border border-gray-200 rounded-lg hover:shadow-sm transition-shadow">
        <div class="flex-1 min-w-0">
          <!-- Description with icon -->
          <p class="text-sm font-medium text-gray-900 truncate mb-2 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-blue-600" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <%= url.description.presence || "Shared Assessment Link" %>
          </p>
          
          <!-- URL with improved copy UI -->
          <div class="flex items-center gap-2 mb-2">
            <div class="flex-1 bg-gray-50 p-2 rounded text-xs text-gray-700 break-all border border-gray-200">
              <%= link_to shared_assessment_url(url.uuid), 
                         shared_assessment_path(url.uuid), 
                         class: "text-blue-600 hover:text-blue-800 hover:underline" %>
            </div>
            <button type="button"
                   data-controller="clipboard"
                   data-clipboard-text-value="<%= shared_assessment_url(url.uuid) %>"
                   data-action="clipboard#copy"
                   class="flex items-center justify-center rounded-md bg-gray-100 hover:bg-gray-200 p-2 transition-colors group"
                   title="Copy to clipboard">
              <span data-clipboard-target="icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-600 group-hover:text-blue-600" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
                  <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
                </svg>
              </span>
              <span data-clipboard-target="feedback" class="text-xs font-medium text-green-600 hidden">
                Copied!
              </span>
            </button>
          </div>
          
          <!-- Expiration info with icon -->
          <% if url.expires_at %>
            <p class="text-xs text-gray-500 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              Expires: <%= url.expires_at.strftime("%b %d, %Y") %>
            </p>
          <% else %>
            <p class="text-xs text-gray-500 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Never expires
            </p>
          <% end %>
        </div>
        
        <!-- Delete button -->
        <%= button_to assessment_sharing_url_path(@assessment, url), 
                     method: :delete,
                     form: { data: { turbo_confirm: "Are you sure you want to delete this sharing link?" } },
                     class: "ml-3 p-1 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors",
                     title: "Delete share link" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>