<div class="space-y-3">
  <% urls.each do |url| %>
    <%= turbo_frame_tag dom_id(url) do %>
      <div class="flex items-start justify-between p-3 bg-gray-50 rounded-lg">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate"><%= url.description %></p>
          <p class="text-xs text-gray-500 mt-1 break-all">
            <%= link_to shared_assessment_url(url.uuid), 
                      shared_assessment_path(url.uuid), 
                      class: "text-blue-600 hover:text-blue-800 hover:underline" %>
          </p>
          <% if url.expires_at %>
            <p class="text-xs text-gray-500 mt-1">
              Expires: <%= url.expires_at.strftime("%Y-%m-%d %H:%M") %>
            </p>
          <% end %>
        </div>
        <%= button_to assessment_sharing_url_path(@assessment, url), 
                    method: :delete,
                    form: { data: { turbo_confirm: "Are you sure you want to delete this sharing link?" } },
                    class: "ml-3 text-gray-400 hover:text-red-600 transition-colors",
                    title: "Delete share link" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>