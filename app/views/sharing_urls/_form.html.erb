<%= form_with(
      model: [assessment, SharingUrl.new],
      class: "space-y-4",
    ) do |f| %>
  <div class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
      <%= f.text_field :description,
                      class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                      placeholder: "e.g., Share with Client" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Expires in</label>
      <%= f.select :expiry,
                  options_for_select([
                    ["Never", nil],
                    ["1 Week", "1_week"],
                    ["1 Month", "1_month"],
                    ["6 Months", "6_months"]
                  ]),
                  {},
                  class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
    </div>

    <%= f.submit "Create Share Link",
                class: "w-full inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
  </div>
<% end %>