<!DOCTYPE html>
<html>
  <head>
    <title>OWASP ASVS</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-100">
    <header class="p-4 bg-blue-600 text-white">
      <nav class="container mx-auto flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <h1 class="text-xl font-bold">
            <%= link_to "OWASP ASVS", root_path, class: "hover:underline" %>
          </h1>
          <% if user_signed_in? %>
            <%= link_to "Assessments", assessments_path, class: "hover:underline" %>
          <% end %>
        </div>
        <div>
          <% if user_signed_in? %>
            <span class="mr-4">Hello, <%= current_user.email %></span>
            <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "hover:underline" %>
          <% else %>
            <%= link_to "Sign Up", new_user_registration_path, class: "mr-4 hover:underline" %>
            <%= link_to "Login", new_user_session_path, class: "hover:underline" %>
          <% end %>
        </div>
      </nav>
    </header>
    <div class="container mx-auto mt-8">
      <% if notice %>
        <div class="p-4 bg-green-100 text-green-800 rounded"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="p-4 bg-red-100 text-red-800 rounded"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
