<!DOCTYPE html>
<html>
  <head>
    <title>OWASP ASVS</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-100">
    <header class="p-4 bg-blue-600 text-white">
      <nav class="container mx-auto flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <h1 class="text-xl font-bold">
            <%= link_to "OWASP ASVS", root_path, class: "hover:underline" %>
          </h1>
          <% if user_signed_in? %>
            <%= link_to "Assessments", assessments_path, class: "hover:underline" %>
          <% end %>
        </div>
        <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <span class="mr-4">Hello, <%= current_user.email %></span>
            <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "hover:underline" %>
          <% else %>
            <%= link_to "Sign Up", new_user_registration_path, class: "mr-4 hover:underline" %>
            <%= link_to "Login", new_user_session_path, class: "hover:underline" %>
          <% end %>
          <%= link_to "https://github.com/marcbest/owasp-asvs", target: "_blank", rel: "noopener", class: "hover:underline" do %>
            <svg fill="currentColor" viewBox="0 0 16 16" class="w-6 h-6" aria-hidden="true">
              <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38 
              0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 
              1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 
              0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 012-.27c.68 0 1.36.09 
              2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 
              0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 
              0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          <% end %>
        </div>
      </nav>
    </header>
    <div class="container mx-auto mt-8">
      <% if notice %>
        <div class="p-4 bg-green-100 text-green-800 rounded"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="p-4 bg-red-100 text-red-800 rounded"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
